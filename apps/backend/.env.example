DATABASE_URL="postgresql://postgres:postgres@localhost:5432/feo"
# Neon: set the direct URL for migrations; API queries use DATABASE_URL.
DATABASE_URL_UNPOOLED=
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AI (OpenRouter) — leave LLM_API_KEY empty to run without AI (fallbacks are used)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
AI_MODEL=nvidia/nemotron-3.5-super-vl:free
AI_FALLBACK_MODEL=dots-studio/dots-3-note-preview:free
AI_MODEL_FAST=google/gemma-4-31b-it:free
AI_MODEL_ALT=google/gemma-4-26b-a4b-it:free
AI_TIMEOUT_MS=45000
AI_DAILY_LIMIT_PER_USER=60

# Optional: YouTube cookies make anti-bot challenges much rarer.
# Either a Netscape cookies.txt exported from a logged-in browser...
YTDLP_COOKIES=
# ...or read them straight from a local browser profile (e.g. firefox, chrome)
YTDLP_COOKIES_FROM_BROWSER=

# Public URL of the API (OAuth callbacks). On Render, RENDER_EXTERNAL_URL is used automatically.
PUBLIC_API_URL=
# "Continue with Google": https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: <PUBLIC_API_URL>/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Continue with GitHub": https://github.com/settings/developers → New OAuth App
#   Authorization callback URL: <PUBLIC_API_URL>/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Deep link of the mobile app after an OAuth login
MOBILE_OAUTH_REDIRECT=feo://auth

# Password reset emails (https://resend.com). Without a key, emails are only printed in the logs.
RESEND_API_KEY=
MAIL_FROM="FEO <onboarding@resend.dev>"
