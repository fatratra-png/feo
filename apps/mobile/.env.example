# API the app talks to. On a physical phone, localhost is the phone itself:
# use the computer's LAN address while developing, the hosted API in a build.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3001/api

# Web origin that hosts the YouTube embed fallback (used when the audio proxy is blocked).
EXPO_PUBLIC_EMBED_ORIGIN=https://feo-swart.vercel.app
