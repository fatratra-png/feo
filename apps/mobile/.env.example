# Address of the FEO API as seen from the phone (use your computer's LAN IP, not localhost)
EXPO_PUBLIC_API_URL=http://192.168.1.20:3001/api

# Origin the hidden YouTube player claims to be served from (fallback when the API is
# blocked by YouTube). Use the web app's domain; defaults to https://feo.app
# EXPO_PUBLIC_EMBED_ORIGIN=https://feo.vercel.app
